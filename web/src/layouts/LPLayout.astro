---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdminPanel from '../components/AdminPanel.astro';
import '../styles/global.css';

const { frontmatter } = Astro.props;
---
<!DOCTYPE html>
<html lang="ja" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex, nofollow">
    <title>{frontmatter.title} | つなげモン</title>
    
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3QD251KQ7K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-3QD251KQ7K');
    </script>

    <script is:inline src="https://unpkg.com/lucide@latest"></script>
    <link rel="stylesheet" href="/assets/css/style.css">
</head>

<body class="font-sans text-slate-800 bg-white">
    <!-- プラットフォーム共通ヘッダー -->
    <Header theme={frontmatter} />

    <main class="w-full">
        <slot />
    </main>

    <!-- プラットフォーム共通フッター -->
    <Footer />
    
    <AdminPanel themeSlug={frontmatter.id} hideZip={true} />

    <script is:inline src="/assets/js/main.js"></script>
</body>

</html>
